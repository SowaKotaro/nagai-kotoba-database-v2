<% content_for :title, t("stats.index.meta_title") %>
<%# 説明文は、収録語があれば実数から作る(数は数字の壁と同じ集計) %>
<% content_for :description, stats_meta_description(@stats) %>

<%= render "shared/breadcrumbs",
      items: [ [ t("layouts.breadcrumbs_home"), root_path ], [ t("stats.index.title"), nil ] ] %>

<%# 英字の標識(STATISTICS・UPDATED)は置かない。トップ・一覧・ランキングと同じく見出しは日本語だけにする(docs/design.md §5.8)。
    集計の時点は下の 1 行が日本語で言う %>
<header class="page-header">
  <h1 class="page-title"><%= t("stats.index.title") %></h1>
  <%# リードは文ごとに行を分け、文節の切れ目でだけ折る(ランキングのリードと同じ) %>
  <p class="page-lead"><%= phrased_sentences(t("stats.index.lead")) %></p>
  <p class="stats-computed"><%= t("stats.index.computed_at", time: @stats.computed_at.strftime("%Y-%m-%d %H:%M")) %></p>
</header>

<% if @stats.word_count.zero? %>
  <p class="empty-note"><%= icon "binoculars" %><%= t("stats.index.empty") %></p>
<% else %>
  <%# 章はトップ・一覧・ランキングと同じ墨の枠の札(.panel)に 1 枚ずつ収めて積む(docs/design.md §5.13)。
      札の頭はアイコンと日本語の見出しだけ。中身は区画(.panel__body)ごとに淡い罫で仕切る %>
  <div class="panel-shelf">
    <%# 統計ページ §1「ワードクラウド」。頻度は事前集計のため、集計ファイルが無ければ丸ごと出さない %>
    <% if MorphemeFrequencies.available? %>
      <section class="panel stats-section stats-section--word-cloud">
        <div class="panel__head">
          <h2 class="panel__title"><%= icon "text_aa" %><%= t("stats.index.word_cloud.title") %></h2>
        </div>
        <div class="panel__body">
          <p class="stats-section__lead"><%= phrased_sentences(t("stats.index.word_cloud.lead")) %></p>
          <%= render "word_cloud" %>
        </div>
      </section>
    <% end %>

    <%# 数字の壁: 4群×5指標を群ごとの札に %>
    <%= render "number_wall" %>

    <section class="panel stats-section">
      <div class="panel__head">
        <h2 class="panel__title"><%= icon "grid_nine" %><%= t("stats.index.sound_matrix.title") %></h2>
      </div>
      <%# 図ごとの区画(.panel__body)を、罫で仕切って縦に積む %>
      <div class="stats-section__bodies">
        <%= render "sound_matrix" %>
      </div>
    </section>

    <section class="panel stats-section">
      <div class="panel__head">
        <h2 class="panel__title"><%= icon "ruler" %><%= t("stats.index.length_chart.title") %></h2>
      </div>
      <div class="panel__body">
        <p class="stats-section__lead"><%= phrased_sentences(t("stats.index.length_chart.lead")) %></p>
        <div data-controller="panel-switch">
          <div class="segmented" role="group" aria-label="<%= t("stats.index.length_chart.toggle_label") %>">
            <button type="button" class="segmented__button" aria-pressed="true"
                    data-panel-switch-target="button" data-panel-key="chars" data-action="panel-switch#show"><%= t("stats.index.length_chart.toggle_chars") %></button>
            <button type="button" class="segmented__button" aria-pressed="false"
                    data-panel-switch-target="button" data-panel-key="mora" data-action="panel-switch#show"><%= t("stats.index.length_chart.toggle_mora") %></button>
          </div>
          <div data-panel-switch-target="panel" data-panel-key="chars">
            <%= render "length_chart", distribution: @stats.reading_length_distribution, param: :reading_length,
                  overflow_param: :reading_length_min,
                  title_key: "stats.index.length_chart.chars_bar_title", aria: t("stats.index.length_chart.chars_aria") %>
            <%= render "finding", sentences: [ stats_finding(@stats, :reading_length), stats_finding(@stats, :longest) ] %>
          </div>
          <div data-panel-switch-target="panel" data-panel-key="mora" hidden>
            <%= render "length_chart", distribution: @stats.mora_distribution, param: :mora_count,
                  title_key: "stats.index.length_chart.mora_bar_title", aria: t("stats.index.length_chart.mora_aria") %>
            <%= render "finding", sentences: [ stats_finding(@stats, :mora) ] %>
            <p class="stats-hint"><%= phrased_sentences(t("stats.index.length_chart.mora_hint")) %></p>
          </div>
        </div>
      </div>
    </section>

    <%# id はホームの「数字で見る長い言葉」の升からのリンク先(HomeHelper::HOME_STATS_FIGURES)。変えるときはホームも直す。
        いまの収録語数は札の頭の右端に、数字の壁と同じ墨の 800 で立てる %>
    <section class="panel stats-section" id="timeline">
      <div class="panel__head stats-section__head">
        <h2 class="panel__title"><%= icon "chart_line_up" %><%= t("stats.index.timeline.title") %></h2>
        <p class="stats-current">
          <span class="stats-current__value"><%= number_with_delimiter(@stats.word_count) %></span><span class="stats-current__unit"><%= t("stats.index.unit.words") %></span>
          <% if @stats.growth[:this_month].positive? %>
            <span class="stats-current__delta"><%= t("stats.index.timeline.this_month", count: number_with_delimiter(@stats.growth[:this_month])) %></span>
          <% end %>
        </p>
      </div>
      <div class="panel__body">
        <p class="stats-section__lead"><%= phrased_sentences(t("stats.index.timeline.lead")) %></p>
        <% periods = [ [ "all", t("stats.index.timeline.period_all"), @stats.timeline ] ] %>
        <% periods << [ "m6", t("stats.index.timeline.period_6m"), @stats.timeline.last(26) ] if @stats.timeline.size > 26 %>
        <% periods << [ "m3", t("stats.index.timeline.period_3m"), @stats.timeline.last(13) ] if @stats.timeline.size > 13 %>
        <div data-controller="panel-switch">
          <% if periods.size > 1 %>
            <div class="segmented" role="group" aria-label="<%= t("stats.index.timeline.period_label") %>">
              <% periods.each_with_index do |(key, label, _weeks), index| %>
                <button type="button" class="segmented__button" aria-pressed="<%= index.zero? %>"
                        data-panel-switch-target="button" data-panel-key="<%= key %>" data-action="panel-switch#show"><%= label %></button>
              <% end %>
            </div>
          <% end %>
          <% periods.each_with_index do |(key, _label, weeks), index| %>
            <div data-panel-switch-target="panel" data-panel-key="<%= key %>" <%= "hidden" unless index.zero? %>>
              <%= render "timeline_chart", weeks: weeks %>
            </div>
          <% end %>
        </div>
        <%= render "finding", sentences: [ stats_finding(@stats, :timeline) ] %>
      </div>
    </section>

    <% if @stats.genre_map[:covered].positive? %>
      <section class="panel stats-section">
        <div class="panel__head">
          <h2 class="panel__title"><%= icon "tag" %><%= t("stats.index.genre_map.title") %></h2>
        </div>
        <div class="panel__body">
          <p class="stats-section__lead"><%= phrased_sentences(t("stats.index.genre_map.lead")) %></p>
          <%= render "genre_sunburst" %>
          <%= render "finding", sentences: [ stats_finding(@stats, :genre) ] %>
          <p class="stats-covered"><%= t("stats.index.annotated_note", count: number_with_delimiter(@stats.genre_map[:covered])) %></p>
        </div>
      </section>
    <% end %>

    <% if @stats.origins[:categories].any? || @stats.entity_types.any? %>
      <section class="panel stats-section">
        <div class="panel__head">
          <h2 class="panel__title"><%= icon "globe_hemisphere_east" %><%= t("stats.index.origins.title") %></h2>
        </div>
        <div class="stats-section__bodies">
          <%= render "origins" %>
        </div>
      </section>
    <% end %>

    <section class="panel stats-section">
      <div class="panel__head">
        <h2 class="panel__title"><%= icon "music_notes" %><%= t("stats.index.sound.title") %></h2>
      </div>
      <div class="stats-section__bodies">
        <%= render "sound_breakdown" %>
      </div>
    </section>

    <% if @stats.feature_ranking[:rows].any? %>
      <section class="panel stats-section">
        <div class="panel__head">
          <h2 class="panel__title"><%= icon "pen_nib" %><%= t("stats.index.features.title") %></h2>
        </div>
        <div class="panel__body">
          <p class="stats-section__lead"><%= phrased_sentences(t("stats.index.features.lead")) %></p>
          <%= render "feature_ranking" %>
          <%= render "finding", sentences: [ stats_finding(@stats, :feature) ] %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>

<p class="stats-colophon"><%= t("stats.index.colophon", credit: t("pages.about.license_credit", url: SiteUrl.origin)) %></p>
