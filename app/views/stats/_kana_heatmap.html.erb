<%# 50音表のヒートマップ(索引ページと同じ部品 shared/_kana_heat_grid を使う)。
    locals: counts({ カナ => 語義数 }) / param(:first_char か :last_char) / heading %>
<div class="stats-kana">
  <h3 class="stats-subheading"><%= heading %></h3>
  <%= render "shared/kana_heat_grid", counts: counts, param: param, max: counts.values.max.to_i %>
</div>
