<%# locals: (genre_map:) -%>
<%# ジャンル別の語義数(docs/stats.md §5)。左にサンバースト(常に「中心+2階層」)、右に、いま見ている階層の内訳
    (名前・語義数・割合・横棒の行。小分類は件数つきのタグ)。扇か行を押すと 1 階層ずつ掘り下がる。
    データは JSON で埋め込み、図と内訳は genre_sunburst_controller が描く(行・タグ・パンくずは下の template を複製する) %>
<%= tag.div class: "genre-analysis", data: genre_sunburst_data do %>
  <script type="application/json" data-genre-sunburst-target="data"><%= raw ERB::Util.json_escape(genre_map[:groups].to_json) %></script>

  <div class="genre-analysis__figure">
    <svg class="genre-sunburst" role="img" aria-label="<%= t("stats.index.genre_map.figure_label") %>" data-genre-sunburst-target="figure"></svg>
  </div>

  <div class="genre-analysis__detail">
    <ol class="genre-crumbs" data-genre-sunburst-target="crumbs"></ol>
    <ul class="genre-rows" data-genre-sunburst-target="rows"></ul>
  </div>

  <template data-genre-sunburst-target="crumbTemplate">
    <li><button type="button" data-action="genre-sunburst#open"></button></li>
  </template>
  <template data-genre-sunburst-target="currentTemplate">
    <li><span aria-current="true"></span></li>
  </template>
  <template data-genre-sunburst-target="rowTemplate">
    <li>
      <button type="button" class="genre-row" data-action="click->genre-sunburst#open mouseenter->genre-sunburst#heat mouseleave->genre-sunburst#cool">
        <span data-field="name"></span>
        <span class="genre-row__count" data-field="count"></span>
        <span class="genre-row__share"><span data-field="share"></span><%= t("stats.index.genre_map.share_unit") %></span>
        <span class="genre-row__bar" data-field="bar"></span>
      </button>
    </li>
  </template>
  <template data-genre-sunburst-target="tagTemplate">
    <li>
      <a class="tag genre-hub__small" data-action="mouseenter->genre-sunburst#heat mouseleave->genre-sunburst#cool">
        <span data-field="name"></span>
        <span class="genre-hub__count" data-field="count"></span>
      </a>
    </li>
  </template>
<% end %>
<noscript><p class="stats-hint"><%= t("stats.index.genre_map.noscript") %></p></noscript>
