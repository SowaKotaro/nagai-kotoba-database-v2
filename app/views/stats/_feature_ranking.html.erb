<%# 統計ページ §8「言語学的特徴」の見本つきランキング。
    件数バーに、実例語の該当部分へ淡いハイライト(単語詳細の注釈と同じ文法)を添える。
    特徴名はチップ → 特徴での絞り込み検索へ %>
<% ranking = @stats.feature_ranking %>
<%# 棒の長さ(bar_percent)は SiteStatistics#feature_ranking が先頭(最多)の行を 100 として返す。最多の色は
    CSS の .feature-rank__row:first-child が付けるので、件数の多い順に返すことが前提(_sound_breakdown の頭子音と同じ) %>
<ol class="feature-rank">
  <% ranking[:rows].each do |row| %>
    <li class="feature-rank__row">
      <div class="feature-rank__head">
        <%= link_to row[:name], words_path(linguistic_feature_id: row[:id]), class: "tag" %>
        <span class="feature-rank__count"><%= t("stats.index.features.count", count: number_with_delimiter(row[:count])) %></span>
        <% if (example = row[:example]) %>
          <%# 該当部分をハイライトした実例(切り分けは feature_example_segments) %>
          <% before, target, after = feature_example_segments(example) %>
          <span class="feature-rank__example"><%= safe_join([ before, content_tag(:span, target, class: "feature-rank__target"), after ]) %></span>
        <% end %>
      </div>
      <div class="feature-rank__bar">
        <span class="feature-rank__fill" style="--w: <%= row[:bar_percent] %>%"></span>
      </div>
    </li>
  <% end %>
</ol>
