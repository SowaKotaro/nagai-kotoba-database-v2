<%# ホーム: 印(サイト名の読みの円環) → 看板 → 札の棚(今日の一語 → 2つのリスト)。
    看板は手本と同じく 1 列の中央揃えで、検索の下に探し方の入口を並べて終える(数は置かない)。
    棚の札は看板の検索バー・ボタンと同じ墨の枠で囲み、英字の標識(アイブロウ)は置かない(docs/design.md §5.2)。 %>
<%# <title> はタグライン付き、meta description は長めの専用文言(ヒーロー見出しとは別管理) %>
<% content_for :title, t("home.index.title_tagline") %>
<% content_for :description, t("home.index.meta_description") %>

<%# 印・看板の帯と札の棚は、それぞれが幅と余白を持つので、main の幅と左右の余白を外す %>
<% content_for :main_class, "container--flush" %>

<%# ページの一番上に置く印。**サイト名の読み**「ナガイコトバノデータベース」を五十音の円環で
    一筆書きにした線画で、手本(しずかなインターネット)がロゴの図を最上部に置くのと同じ役割。
    実データ(読み)から生まれる図なので、飾りでありながら嘘がない %>
<section class="band band--mark">
  <div class="band__inner">
    <%= render "shared/kana_ring_art", reading: t("home.index.site_reading"),
          modifier: "ring-art--mark", arc_label: t("labels.en.site") %>
  </div>
</section>

<%# 看板: 札に載せず、地の上に直接置く。手本(しずかなインターネット)と同じく
    見出し → 説明 → 検索 → 探し方の入口 を 1 列に中央揃えで積む %>
<section class="band band--hero">
  <div class="band__inner masthead">
    <h1 class="hero__title"><%= t("home.index.hero_title") %></h1>
    <%# 説明は文ごとに行を分け、文節の切れ目でだけ折る(幅だけで折ると「ジャ / ンル」のように語の途中で割れる)。
        文言は meta description の既定と同じ 1 本(ApplicationHelper#page_description はつないで使う) %>
    <p class="hero__lead"><%= phrased_sentences(t("home.index.description")) %></p>

    <%# 入力欄の案内は「単語を検索」だけ。例文を添えるとスマホで途中で切れる(docs/design.md §5.2) %>
    <%= form_with url: words_path, method: :get, class: "hero-search" do %>
      <%= icon "magnifying_glass" %>
      <%= text_field_tag :q, nil, placeholder: t("layouts.search_placeholder"),
            class: "hero-search__input", aria: { label: t("searches.q_label") } %>
      <button type="submit" class="hero-search__submit"><%= t("layouts.search_submit") %></button>
    <% end %>

    <%# 探し方の入口(HomeHelper#home_search_ways)。選択肢を持つものは押すとその場で開くボタン(∨)、
        ほかはそのページへ進むボタン(→)。語と印だけを置き、説明やアイコンは添えない(docs/design.md §5.2)。
        描いた結果は、選択肢が変わるまで使い回す(HomeHelper#home_search_ways_cache_key) %>
    <% cache home_search_ways_cache_key do %>
      <nav class="search-ways" aria-label="<%= t("home.index.search_ways") %>">
        <% home_search_ways.each do |way| %>
          <% if way[:options] %>
            <%= render "home/search_way_menu", way: way %>
          <% else %>
            <%= link_to way[:path], class: "btn search-ways__item", rel: way[:rel] do %><%= way[:label] %><%= icon "arrow_right" %><% end %>
          <% end %>
        <% end %>
        <%# 狭い幅で開いたパネル(画面の下からのシート)のうしろを覆う幕。どのメニューの外でもあるので、押すと閉じる(nav-menu#closeOnOutside) %>
        <div class="search-ways__scrim" aria-hidden="true"></div>
      </nav>
    <% end %>
  </div>
</section>

<%# ここから下は札の棚。今日の一語 → 2 つのリスト → 数字で見る長い言葉を 1 列に積む %>
<div class="home-shelf">

<% if @featured_word %>
  <% featured_sense = @featured_word.primary_sense %>
  <section class="panel home-featured">
    <div class="panel__head">
      <h2 class="panel__title"><%= t("home.index.featured") %></h2>
      <%= link_to word_path(@featured_word), class: "btn btn--sm panel__more" do %>
        <%= t("home.index.featured_more") %><%= icon "arrow_right" %>
      <% end %>
    </div>
    <div class="home-featured__body">
      <div>
        <%= link_to @featured_word.surface, word_path(@featured_word), class: "home-featured__word" %>
        <p class="home-featured__reading"><%= @featured_word.ordered_senses.map(&:reading).join("、") %></p>
        <% if featured_sense&.meaning.present? %>
          <p class="home-featured__meaning"><%= truncate(featured_sense.meaning, length: 120) %></p>
        <% end %>

        <%# その語が持つ関連データ。並べるためではなく、どれも単語一覧の絞り込みへの
            実リンクにして「ここから辿れる」ことを見せる(docs/design.md §5.5)。
            ジャンルはパンくず、ほかは丸タグ。細かい値は詳細ページに任せる %>
        <% if featured_sense %>
          <div class="home-featured__data">
            <% if featured_sense.genre %>
              <%= render "shared/genre_path", genre: featured_sense.genre %>
            <% end %>

            <div class="tag-row">
              <% if featured_sense.entity_type %>
                <%= link_to featured_sense.entity_type.name,
                      words_path(entity_type_id: featured_sense.entity_type_id), class: "tag" %>
              <% end %>
              <% if featured_sense.part_of_speech %>
                <%= link_to featured_sense.part_of_speech.name,
                      words_path(part_of_speech_id: featured_sense.part_of_speech_id), class: "tag" %>
              <% end %>
              <% featured_sense.word_origins.each do |origin| %>
                <%= link_to origin.name, words_path(word_origin_id: origin.id), class: "tag" %>
              <% end %>
              <% if featured_sense.reading_length %>
                <%= link_to t("words.show.chars", count: featured_sense.reading_length),
                      words_path(reading_length: featured_sense.reading_length), class: "tag" %>
              <% end %>
              <% if featured_sense.mora_count %>
                <%= link_to t("words.show.mora", count: featured_sense.mora_count),
                      words_path(mora_count: featured_sense.mora_count), class: "tag" %>
              <% end %>
              <%# 先頭・末尾の文字。しりとりの入口でもあるので、絞り込みへ繋いでおく %>
              <% if featured_sense.first_char.present? %>
                <%= link_to t("home.index.first_char_tag", char: featured_sense.first_char),
                      words_path(first_char: featured_sense.first_char), class: "tag" %>
              <% end %>
              <% if featured_sense.last_char.present? %>
                <%= link_to t("home.index.last_char_tag", char: featured_sense.last_char),
                      words_path(last_char: featured_sense.last_char), class: "tag" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# 写真ではなく、その語の読みを五十音の円環で一筆書きにした線画を添える。説明(キャプション)は添えない(docs/design.md §5.9) %>
      <% if (featured_reading = featured_sense&.reading).present? %>
        <%= render "shared/kana_ring_art", reading: featured_reading %>
      <% end %>
    </div>
  </section>
<% end %>

<%# 新着の行には NEW の印を付けない(見出しが新着だと言い、公開日も出ている) %>
<section class="panel home-column">
  <div class="panel__head">
    <h2 class="panel__title"><%= t("home.index.recent") %></h2>
    <%= link_to words_path, class: "btn btn--sm panel__more" do %>
      <%= t("home.index.see_all") %><%= icon "arrow_right" %>
    <% end %>
  </div>
  <div class="home-column__list">
    <% @recent_words.each do |word| %>
      <%= link_to word_path(word), class: "home-column__item" do %>
        <span class="home-column__body">
          <span class="home-column__word"><%= word.surface %></span>
          <span class="home-column__reading"><%= word.primary_sense&.reading %></span>
        </span>
        <span class="home-column__meta"><%= l(word.annotated_at.to_date, format: :short) %></span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="panel home-column">
  <div class="panel__head">
    <h2 class="panel__title"><%= t("home.index.ranking") %></h2>
    <%= link_to rankings_path, class: "btn btn--sm panel__more" do %>
      <%= t("home.index.see_ranking") %><%= icon "arrow_right" %>
    <% end %>
  </div>
  <div class="home-column__list">
    <% @longest_words.each_with_index do |word, index| %>
      <%= link_to word_path(word), class: "home-column__item" do %>
        <span class="home-column__rank"><%= index + 1 %></span>
        <span class="home-column__body">
          <span class="home-column__word"><%= word.surface %></span>
          <span class="home-column__reading"><%= word.primary_sense&.reading %></span>
        </span>
        <%# 文字数はこの欄の主題なので、数だけを大きく立てる。単位はランキングの同じ板(読みが長い言葉)から引く %>
        <% if (length = word.primary_sense&.reading_length) %>
          <span class="home-column__meta"><span class="home-column__number"><%= length %></span><%= t("rankings.boards.length_desc.unit") %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>

<%# 統計ページへの入口。数字の壁から選んだ数を升に並べ、升ごとにその数を図で見せる章へ送る(HomeHelper#home_stats_figures) %>
<% if @figures.scale[:words].positive? %>
  <section class="panel home-figures">
    <div class="panel__head">
      <h2 class="panel__title"><%= t("home.index.figures.title") %></h2>
      <%= link_to stats_path, class: "btn btn--sm panel__more" do %>
        <%= t("home.index.figures.more") %><%= icon "arrow_right" %>
      <% end %>
    </div>
    <div class="home-figures__grid">
      <% home_stats_figures(@figures).each do |figure| %>
        <%= link_to figure[:path], class: "home-figures__item" do %>
          <span class="home-figures__label"><%= figure[:label] %></span>
          <span class="home-figures__value"><%= figure[:value] %><span class="home-figures__unit"><%= figure[:unit] %></span></span>
        <% end %>
      <% end %>
    </div>
    <p class="home-figures__note"><%= t("stats.index.computed_at", time: @figures.computed_at.strftime("%Y-%m-%d")) %></p>
  </section>
<% end %>
</div>
