<% content_for :title, t("pages.privacy.title") %>
<% content_for :description, t("pages.privacy.description") %>

<%= render "shared/breadcrumbs",
      items: [ [ t("layouts.breadcrumbs_home"), root_path ], [ t("pages.privacy.title"), nil ] ] %>

<%# 英字の標識(PRIVACY)は置かない。トップ・一覧と同じく見出しは日本語だけにする(docs/design.md §5.6.1) %>
<header class="page-header">
  <h1 class="page-title"><%= t("pages.privacy.title") %></h1>
  <p class="page-lead"><%= phrased_sentences(t("pages.privacy.lead")) %></p>
</header>

<%# 章は 1 つずつ墨の枠の札に収め、札の棚に積む(About と同じ組み) %>
<div class="panel-shelf">
  <%# 外部送信規律(改正電気通信事業法)の公表事項: 送信先事業者・送信される情報・利用目的。
      名前と値の行に組み、本文の区画で挟む %>
  <%= render layout: "pages/chapter", locals: { icon_name: "graph", title: t("pages.privacy.analytics_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.analytics_body") %></p>
    </div>
    <dl class="fact-list">
      <div class="fact-list__item">
        <dt><%= t("pages.privacy.analytics_destination_label") %></dt>
        <dd><%= t("pages.privacy.analytics_destination") %></dd>
      </div>
      <div class="fact-list__item">
        <dt><%= t("pages.privacy.analytics_data_label") %></dt>
        <dd><%= t("pages.privacy.analytics_data") %></dd>
      </div>
      <div class="fact-list__item">
        <dt><%= t("pages.privacy.analytics_purpose_label") %></dt>
        <dd><%= t("pages.privacy.analytics_purpose") %></dd>
      </div>
    </dl>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.analytics_links_intro") %></p>
      <ul>
        <li><%= link_to t("pages.privacy.analytics_google_policy"),
                  "https://policies.google.com/privacy",
                  rel: "noopener external", target: "_blank" %></li>
        <li><%= link_to t("pages.privacy.analytics_partner_policy"),
                  "https://policies.google.com/technologies/partner-sites",
                  rel: "noopener external", target: "_blank" %></li>
      </ul>
      <p>
        <%= link_to t("pages.privacy.analytics_optout"),
              "https://tools.google.com/dlpage/gaoptout",
              rel: "noopener external", target: "_blank" %>
      </p>
    </div>
  <% end %>

  <%= render layout: "pages/chapter", locals: { icon_name: "cookie", title: t("pages.privacy.cookie_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.cookie_body") %></p>
    </div>
  <% end %>

  <%= render layout: "pages/chapter", locals: { icon_name: "list_checks", title: t("pages.privacy.log_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.log_body") %></p>
    </div>
  <% end %>

  <%# 収録リクエスト・フォーム(Issue 75)は、このサイトで唯一利用者から情報を受け取る経路。
      何を保存し、何に使うかをアクセスログとは別項目として公表する %>
  <%= render layout: "pages/chapter", locals: { icon_name: "paper_plane_tilt", title: t("pages.privacy.request_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.request_body") %></p>
      <p><%= t("pages.privacy.request_purpose") %></p>
    </div>
  <% end %>

  <%= render layout: "pages/chapter", locals: { icon_name: "pencil_simple", title: t("pages.privacy.changes_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.changes_body") %></p>
    </div>
  <% end %>

  <%= render layout: "pages/chapter", locals: { icon_name: "envelope_simple", title: t("pages.privacy.contact_title") } do %>
    <div class="panel__body prose">
      <p><%= t("pages.privacy.contact_body") %></p>
      <p><%= mail_to t("pages.about.contact_email") %></p>
    </div>
  <% end %>
</div>
