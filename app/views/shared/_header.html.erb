<%# グローバルヘッダー(docs/design.md §5.1)。サイト名 + ナビ(現在地表示)。
    キーワード検索はヘッダーに常設せず、トップページのヒーロー中央に置く(検索を主役にするため)。
    900px 以下ではナビをハンバーガーで開閉するドロワーに格納する(nav-drawer コントローラ)。
    ページを下へ送ると流れ去るヘッダーを、上へ少し戻したときに降ろす(header-reveal)のは公開側だけ。
    管理画面は、画面ごとに貼り付く自前の部品(アノテーションの側面・下端のバー)を持つので外す(docs/design.md §10) %>
<% reveal = !admin_page? %>
<%# header-reveal が受ける合図: ドロワーが開いている間は出したままにし(hold)、閉じたら手放す(release)。
    フォーカスが入ったら出す(reveal)。Turbo のキャッシュの直前に出入りの状態を畳み(reset)、ページが切り替わって
    スクロール位置が飛んだあとは基準を取り直す(sync) %>
<% reveal_actions = %w[nav-drawer:open->header-reveal#hold nav-drawer:close->header-reveal#release
                       focusin->header-reveal#reveal turbo:before-cache@document->header-reveal#reset
                       turbo:load@document->header-reveal#sync] %>
<header class="site-header" data-controller="nav-drawer<%= " header-reveal" if reveal %>"
        data-action="keydown.esc@window->nav-drawer#close turbo:before-cache@document->nav-drawer#close<%= " #{reveal_actions.join(" ")}" if reveal %>"
        data-nav-drawer-open-label-value="<%= t("layouts.menu_open") %>"
        data-nav-drawer-close-label-value="<%= t("layouts.menu_close") %>">
  <div class="site-header__inner">
    <%# 左はサイト名だけ。円環のブランドマークと 3 行の英字は 2026-11-04 に外した(docs/design.md §5.1)。
        触れている間は「長」のあとに伸ばし棒が伸び、離すとぷるんと戻る(motion.css の 3)。「い」から後ろを送るために
        1 字ずつ包み、伸ばし棒は 1 字目の擬似要素で描く(本文の文字にしないので、コピーや検索エンジンには出ない)。
        読み上げは aria-label で名前ひとつにまとめる。字のあいだに空白を挟まないよう、1 つの式で組む %>
    <%= link_to safe_join(t("layouts.brand").each_char.with_index.map { |char, index|
          tag.span(char, class: "site-brand__char", data: index.zero? ? { stretch_mark: t("layouts.brand_stretch_mark") } : {})
        }), root_path, class: "site-brand", aria: { label: t("layouts.brand") } %>

    <%# 三本線は開くと × になり(layout.css)、ドロワーとスクリムの手前に出て、そのまま閉じるボタンになる。
        ドロワーの頭には閉じるボタンを別に持たない(同じ位置に 2 つ重ねず、同じ 1 つが形を変える) %>
    <button type="button" class="nav-toggle" aria-label="<%= t("layouts.menu_open") %>" aria-expanded="false"
            aria-controls="site-drawer" data-nav-drawer-target="button" data-action="nav-drawer#toggle">
      <span class="nav-toggle__bars" aria-hidden="true">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </span>
    </button>

    <div class="site-header__right" id="site-drawer" data-nav-drawer-target="panel">
      <%# ドロワーの頭(狭幅だけ。広い幅では出さない)。ヘッダーと同じ高さに組んで下に墨の罫を引く。
          右端はハンバーガー(× になっている)が手前に重なる(docs/design.md §5.1) %>
      <div class="nav-drawer__head">
        <span class="nav-drawer__title"><%= t("layouts.menu_title") %></span>
      </div>

      <nav class="site-nav">
        <%= link_to t("layouts.nav.words"), words_path, class: ("is-current" if request.path == words_path) %>
        <%# ランキング。読みの長さをはじめ、さまざまな観点のランキングを束ねたハブ %>
        <%= link_to t("layouts.nav.ranking"), rankings_path, class: ("is-current" if request.path == rankings_path) %>
        <%# 収録統計(Issue 34) %>
        <%= link_to t("layouts.nav.stats"), stats_path, class: ("is-current" if request.path == stats_path) %>

        <%# 「検索」はプルダウン。配下に、詳細検索から切り出した探し方(ジャンル・エンティティ・言語学的特徴・索引)と
            詳細検索を束ねる(ApplicationHelper#search_ways)。ホームの探し方の入口は、これに読みの長さ・語種・品詞・ランダムを足したもの %>
        <% ways = search_ways %>
        <div class="nav-menu" data-controller="nav-menu"
             data-action="click@window->nav-menu#closeOnOutside keydown.esc@window->nav-menu#close">
          <button type="button" id="nav-menu-search-trigger"
                  class="nav-menu__trigger <%= "is-current" if ways.any? { |way| way[:path] == request.path } %>"
                  aria-expanded="false" aria-haspopup="true" aria-controls="nav-menu-search"
                  data-nav-menu-target="trigger" data-action="nav-menu#toggle">
            <%= t("layouts.nav.search") %><%= icon "caret_down", "nav-menu__caret" %>
          </button>
          <div class="nav-menu__panel" id="nav-menu-search" hidden
               data-nav-menu-target="panel" aria-labelledby="nav-menu-search-trigger">
            <%# 各項目に小さなアイコンを添える(ジャンル=タグ / エンティティ=立方体 / 言語学的特徴=ペン先 / 索引=50音表 / 詳細検索=絞り込み) %>
            <%# 行の包み(.nav-menu__list)は、狭幅のドロワーで高さを 0 から伸ばして畳むための器(layout.css) %>
            <div class="nav-menu__list">
              <% ways.each do |way| %>
                <%= link_to way[:path], class: ("is-current" if request.path == way[:path]) do %>
                  <%= icon way[:icon] %><span><%= way[:label] %></span>
                <% end %>
              <% end %>
            </div>
          </div>
        </div>

        <%# 収録リクエスト(Issue 75)。受付を止めている間は導線ごと隠す %>
        <% if requests_open? %>
          <%= link_to t("layouts.nav.requests"), new_request_path,
                class: ("is-current" if request.path == new_request_path) %>
        <% end %>

        <% if authenticated? %>
          <%= link_to t("layouts.nav.admin"), admin_root_path, class: ("is-current" if admin_page?) %>
          <%= button_to t("layouts.nav.logout"), session_path, method: :delete %>
        <% end %>
      </nav>

      <%# ダークモードの切り替え(docs/design.md §9)。既定は OS 設定に追従し、
          押したときだけ手動の指定として記憶する。JS 無効時は OS 設定のみで効くので、
          動かないスイッチを見せないよう noscript で隠す %>
      <div class="theme-toggle" data-controller="theme">
        <button type="button" class="theme-toggle__button" role="switch" aria-checked="false"
                aria-label="<%= t("layouts.theme.toggle") %>"
                data-theme-target="button" data-action="theme#toggle">
          <%= icon "moon", "theme-toggle__icon" %>
          <%# 名前は狭幅のドロワーの行でだけ見せる(広い幅はアイコンとスイッチだけ。どちらも名前は aria-label が持つ) %>
          <span class="theme-toggle__label"><%= t("layouts.theme.toggle") %></span>
          <span class="theme-toggle__track" aria-hidden="true"><span class="theme-toggle__thumb"></span></span>
        </button>
      </div>
      <noscript><style>.theme-toggle { display: none; }</style></noscript>
    </div>

    <div class="nav-drawer__scrim" data-nav-drawer-target="scrim" data-action="click->nav-drawer#close"></div>
  </div>
</header>
