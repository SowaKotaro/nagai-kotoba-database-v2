<% content_for :title, t("genres.index.title") %>
<% content_for :description, t("genres.index.description") %>

<%= render "shared/breadcrumbs",
      items: [ [ t("layouts.breadcrumbs_home"), root_path ], [ t("genres.index.title"), nil ] ] %>

<%# 大分類とその語義数は、ページ頭のレールの図と下の一覧の両方で使うので先に出す %>
<% larges = genres_with_published(nil, @genres_by_parent, @published_counts) %>
<%# 大分類ごとの公開語義数。下の横棒と、レールの放射図の頂点の距離に使う %>
<% large_counts = larges.to_h { |genre| [ genre.id, genre_published_count(genre, @genres_by_parent, @published_counts) ] } %>

<%# 英字の標識(GENRES・階層の深さ)は置かない。トップ・一覧と同じく見出しは日本語だけにする(docs/design.md §5.8) %>
<header class="page-header page-header--rail">
  <div class="page-header__main">
    <h1 class="page-title"><%= t("genres.index.title") %></h1>
    <p class="page-lead"><%= phrased_sentences(t("genres.index.lead", count: number_with_delimiter(@published_counts.size))) %></p>
  </div>

  <%# レール: このページの性格を表す数(公開語をもつ分類の数)と、大分類ごとの語義数を
      円の上に並べた線画。数は単語一覧のレールの件数と同じ墨の 800 で立て、線画には説明を添えない。
      数は PublishedSenseCounts.by_genre のキーの数で、ジャンル未設定(nil)の
      公開語義があればその nil も 1 と数える。ホームの「ジャンル数」(マスタの小分類の全件)・
      統計の「使用ジャンル」(nil を除いた使用中の小分類)とは定義が違う %>
  <div class="page-header__rail">
    <p class="page-header__count"><span class="page-header__count-value"><%= number_with_delimiter(@published_counts.size) %></span><%= t("genres.index.count_unit") %></p>
    <%= render "shared/radial_art", entries: larges.map { |genre| [ genre.name, large_counts[genre.id] ] } %>
  </div>
</header>
<%# 大分類の公開語義数。数字だけだと 143 と 196 の差が読めないので、細い横棒を添えて
    「比べられる図」にする(docs/design.md §5.9)。最大値で割ると 73〜97% に潰れて差が見えないため、
    最小値〜最大値を 20〜100% に写して幅の差を作る(レールの放射図も同じ写像。RadialChart.percent) %>
<% count_min, count_max = large_counts.values.minmax %>
<% if larges.empty? %>
  <p class="empty-note"><%= icon "binoculars" %><%= t("genres.index.empty") %></p>
<% else %>
  <%# 大分類ごとの折り畳み(details)を、トップ・一覧と同じ墨の枠の札(.panel)に収め、行を 1px の隙間で仕切って積む。
      初期表示は大分類の一覧だけに畳み、ジャンルが増えても目的の中・小分類へ迷わず到達できる(検索のジャンル絞り込みと同じ文法)。
      大分類名のクリックは開閉に充てるため、一覧への絞り込みは「全体を見る」リンクに分ける。
      「アニメ」「鉄道」がどの大分類にあるかは開くまで分からないので、札の頭に名前で絞り込む欄を添える(list-filter)。
      絞り込む単位は小分類で、中分類の名前でも当たる(大分類の名前は「芸術・音楽・演劇・スポーツ・娯楽」のように
      広すぎて、当てると配下の数百件が残るだけになるので照らさない) %>
  <section class="panel hub-panel" data-controller="list-filter">
    <div class="panel__head hub-panel__head">
      <h2 class="panel__title"><%= icon "tag" %><%= t("genres.index.panel_title") %></h2>
      <%= render "shared/list_filter_field", label: t("genres.index.filter_label"), placeholder: t("genres.index.filter_placeholder") %>
    </div>
    <div class="genre-hub">
      <% larges.each do |large| %>
        <details class="genre-fold genre-hub__fold" data-list-filter-target="group">
          <summary class="genre-fold__summary genre-hub__summary">
            <%= icon "caret_down", "genre-fold__caret" %>
            <%# 分類の名前は「・」の後ろと「（」の前でだけ折る(狭い幅で「スポー／ツ」と語の途中で折れないように。中・小分類も同じ) %>
            <span class="genre-hub__large-name"><%= phrased_name(large.name) %></span>
            <span class="genre-hub__bar" aria-hidden="true"
                  style="--w: <%= RadialChart.percent(large_counts[large.id], count_min, count_max) %>%"></span>
            <span class="genre-hub__count"><%= large_counts[large.id] %></span>
          </summary>
          <div class="genre-fold__body">
            <%= link_to words_path(genre_id: large.id), class: "btn btn--sm genre-hub__whole" do %>
              <span><%= phrased_name(t("genres.index.whole", name: large.name)) %></span><%= icon "arrow_right" %>
            <% end %>

            <% genres_with_published(large.id, @genres_by_parent, @published_counts).each do |medium| %>
              <div class="genre-hub__medium" data-list-filter-target="group">
                <h3 class="genre-hub__medium-title">
                  <%= link_to phrased_name(medium.name), words_path(genre_id: medium.id) %>
                  <span class="genre-hub__count mono"><%= genre_published_count(medium, @genres_by_parent, @published_counts) %></span>
                </h3>

                <ul class="genre-hub__smalls">
                  <% genres_with_published(medium.id, @genres_by_parent, @published_counts).each do |small| %>
                    <li data-list-filter-target="item" data-filter-terms="<%= medium.name %> <%= small.name %>">
                      <%= link_to words_path(genre_id: small.id), class: "tag genre-hub__small" do %>
                        <span><%= phrased_name(small.name) %></span>
                        <span class="genre-hub__count mono"><%= genre_published_count(small, @genres_by_parent, @published_counts) %></span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
    <%= render "shared/list_filter_empty", text: t("genres.index.filter_empty") %>
  </section>
<% end %>
