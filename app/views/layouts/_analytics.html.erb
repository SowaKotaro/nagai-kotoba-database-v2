<%# GA4(Issue 19)。測定IDは環境変数 GA4_MEASUREMENT_ID。未設定なら何も出力しない。
    ログイン中(管理画面を含む)にも出さない(ApplicationHelper#analytics_enabled?)。
    data-turbo-track="reload" は、タグのあるページと無いページをまたぐ遷移(ログイン・ログアウト)を Turbo に
    フルロードさせるため。付けないと、ログイン前に読み込んだ下の turbo:load のリスナーが document に残り、
    タグの無い管理画面でも page_view を送り続ける。
    Turbo Drive は遷移がフルロードでないため、既定の page_view では2ページ目以降が
    計測されない。send_page_view:false にして turbo:load ごとに page_view を送る。
    下のインライン script に nonce は付けていない(CSP が未設定であることが前提。
    application.html.erb のダークモード復元の注記を参照) %>
<% if analytics_enabled? %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= u ga_measurement_id %>" data-turbo-track="reload"></script>
  <script data-turbo-track="reload">
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= j ga_measurement_id %>', { send_page_view: false });
    document.addEventListener('turbo:load', function(event) {
      gtag('event', 'page_view', {
        page_location: (event.detail && event.detail.url) || window.location.href,
        page_title: document.title
      });
    });
  </script>
<% end %>
