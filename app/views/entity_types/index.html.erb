<% content_for :title, t("entity_types.index.meta_title") %>
<% content_for :description, t("entity_types.index.description") %>

<%= render "shared/breadcrumbs",
      items: [ [ t("layouts.breadcrumbs_home"), root_path ], [ t("entity_types.index.title"), nil ] ] %>

<%# 英字の標識(ENTITY TYPES・種類の数)は置かない。トップ・一覧と同じく見出しは日本語だけにする(docs/design.md §5.8) %>
<header class="page-header">
  <h1 class="page-title"><%= t("entity_types.index.title") %></h1>
  <p class="page-lead"><%= phrased_sentences(t("entity_types.index.lead")) %></p>
</header>

<% if @entity_types.empty? %>
  <p class="empty-note"><%= icon "binoculars" %><%= t("entity_types.index.empty") %></p>
<% else %>
  <%# 語の多い順に並ぶので、探している名前(駅名 など)が後ろに埋もれる。札の頭に名前で絞り込む欄を添える(list-filter)。
      タグの組み(名前の右に件数を等幅で添える)はジャンルの小分類と同じ %>
  <section class="panel hub-panel" data-controller="list-filter">
    <div class="panel__head hub-panel__head">
      <h2 class="panel__title"><%= icon "cube" %><%= t("entity_types.index.panel_title") %></h2>
      <%= render "shared/list_filter_field", label: t("entity_types.index.filter_label"),
            placeholder: t("entity_types.index.filter_placeholder") %>
    </div>
    <div class="panel__body">
      <ul class="entity-hub">
        <% @entity_types.each do |entity_type| %>
          <li data-list-filter-target="item" data-filter-terms="<%= entity_type.name %>">
            <%= link_to words_path(entity_type_id: entity_type.id), class: "tag entity-hub__tag" do %>
              <span><%= phrased_name(entity_type.name) %></span>
              <span class="genre-hub__count mono"><%= number_with_delimiter(@counts[entity_type.id]) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <%= render "shared/list_filter_empty", text: t("entity_types.index.filter_empty") %>
    </div>
  </section>
<% end %>
