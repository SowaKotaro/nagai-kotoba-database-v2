<% content_for :title, t("admin.tags.title") %>

<header class="page-header">
  <h1 class="page-title"><%= t("admin.tags.title") %></h1>
  <p class="page-lead"><%= t("admin.tags.lead") %></p>
</header>

<%# 種別ごとの入口。カードの組みはダッシュボードと共通(components.css の .admin-card)。5 枚が 1 段に並ぶ幅の基準(compact) %>
<section class="panel">
<ul class="admin-dash-grid admin-dash-grid--compact">
  <% @kinds.each do |kind| %>
    <li class="admin-card">
      <%= link_to admin_tag_kind_path(kind.key), class: "admin-card__link" do %>
        <span class="admin-card__title"><%= kind.label %></span>
      <% end %>
      <%= icon "arrow_right", "admin-card__arrow" %>
      <p class="admin-card__desc"><%= t("admin.tags.kind_desc.#{kind.key}") %></p>
      <p class="admin-card__meta"><%= t("admin.tags.count", count: number_with_delimiter(kind.total_count)) %></p>
    </li>
  <% end %>
</ul>
</section>
