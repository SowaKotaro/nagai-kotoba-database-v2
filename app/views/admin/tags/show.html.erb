<% content_for :title, @kind.label %>

<header class="page-header">
  <h1 class="page-title"><%= @kind.label %></h1>
  <p class="page-lead"><%= t("admin.tags.show_lead") %></p>
</header>
<% if @kind.seed_managed_kind? %>
  <p class="field-hint"><%= t("admin.tags.seed_note") %></p>
<% end %>

<% if @kind.creatable? %>
  <%# 新規追加: 名前だけの単純マスタなので、この1パネルで完結させる。 %>
  <details class="panel tag-add" <%= "open" if @new_record&.errors&.any? %>>
    <summary class="panel__summary"><%= t("admin.tags.add.summary", kind: @kind.label) %></summary>
    <div class="panel__body">
    <p class="tag-add__hint"><%= t("admin.tags.add.hint") %></p>

    <% if @new_record&.errors&.any? %>
      <ul class="form-errors">
        <% @new_record.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with url: admin_create_tag_path(@kind.key), method: :post, scope: :tag, class: "tag-add__form" do |form| %>
      <div class="field">
        <%= form.label :name, t("admin.tags.name_label") %>
        <%= form.text_field :name, value: @new_record&.name %>
      </div>
      <%= form.submit t("admin.tags.add.submit"), class: "btn btn--primary" %>
    <% end %>
    </div>
  </details>
<% end %>

<% if @records.any? %>
  <%# 統合: source を付けている全データを target に付け替えて source を削除する。
      ジャンルは同じ階層同士でのみ統合できる。 %>
  <details class="panel tag-merge">
    <summary class="panel__summary"><%= t("admin.tags.merge.summary") %></summary>
    <div class="panel__body">
    <p class="tag-merge__hint"><%= t("admin.tags.merge.hint#{'_genre' if @kind.hierarchical?}") %></p>

    <%# 統合元・統合先は名前で絞り込める一覧にし、統合先は統合元と同じ階層に絞る(tag_merge_controller.js)。
        絞り込む欄は JS がつながってから出す(hidden で描く)。どこにも送らない欄なので name を持たせない %>
    <% merge_options = tag_merge_options(@kind, @records, @usage_counts, @genre_index) %>
    <%= form_with url: admin_merge_tags_path(@kind.key), method: :post, class: "tag-merge__form",
          data: { turbo_confirm: t("admin.tags.merge.confirm"), controller: "tag-merge",
                  tag_merge_empty_value: t("admin.tags.merge.no_match"),
                  action: "turbo:before-cache@document->tag-merge#reset" } do %>
      <div class="tag-merge__pair">
        <% { source: "filterSource", target: "filterTarget" }.each_with_index do |(side, filter), index| %>
          <% if index == 1 %><span class="tag-merge__arrow" aria-hidden="true">→</span><% end %>
          <div class="field tag-merge__side">
            <label for="<%= side %>_id"><%= t("admin.tags.merge.#{side}") %></label>
            <div class="list-filter tag-merge__query" hidden data-tag-merge-target="field">
              <%= icon "funnel" %>
              <%= tag.input type: "search", class: "list-filter__input", autocomplete: "off",
                    placeholder: t("admin.tags.merge.query_placeholder"),
                    aria: { label: t("admin.tags.merge.query_label", side: t("admin.tags.merge.#{side}")) },
                    data: { tag_merge_target: "#{side}Query", action: "input->tag-merge##{filter}" } %>
            </div>
            <%= select_tag "#{side}_id", options_for_select(merge_options), include_blank: t("admin.tags.merge.choose"),
                  class: "tag-merge__select",
                  data: { tag_merge_target: "#{side}Select", action: ("change->tag-merge#filterTarget" if side == :source) } %>
            <% if side == :target && @kind.hierarchical? %>
              <p class="tag-merge__note" hidden data-tag-merge-target="field"><%= t("admin.tags.merge.target_note_genre") %></p>
            <% end %>
          </div>
        <% end %>
      </div>
      <%= submit_tag t("admin.tags.merge.submit"), class: "btn" %>
    <% end %>
    </div>
  </details>

  <% if @kind.hierarchical? %>
    <%= render "admin/tags/genre_tree", kind: @kind, children: @genre_children, usage_counts: @usage_counts,
          deletable_ids: @deletable_ids, genre_index: @genre_index %>
  <% else %>
  <%# 狭幅ではテーブルを潰さず、この枠内で横スクロールさせる %>
  <section class="panel">
  <div class="table-scroll">
  <table class="data-table tag-table">
    <thead>
      <tr>
        <th><%= t("admin.tags.col_name") %></th>
        <th class="tag-table__num"><%= t("admin.tags.col_usage") %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @records.each do |record| %>
        <tr>
          <td class="tag-table__name">
            <%= link_to record.name, admin_edit_tag_path(@kind.key, record) %>
            <% if @kind.seeded?(record) %>
              <span class="tag-table__seed" title="<%= t("admin.tags.seed_badge_title") %>"><%= t("admin.tags.seed_badge") %></span>
            <% end %>
          </td>
          <td class="tag-table__num"><%= number_with_delimiter(@usage_counts[record.id].to_i) %></td>
          <td>
            <div class="actions">
              <%= link_to t("admin.tags.edit"), admin_edit_tag_path(@kind.key, record), class: "btn btn--sm" %>
              <% if @deletable_ids.include?(record.id) %>
                <%= button_to t("admin.tags.destroy"), admin_tag_path(@kind.key, record), method: :delete,
                      class: "btn btn--sm", data: { turbo_confirm: t("admin.tags.confirm_destroy", name: record.name) } %>
              <% else %>
                <span class="tag-table__inuse"><%= t("admin.tags.in_use") %></span>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  </div>
  </section>
  <% end %>
<% else %>
  <p class="empty-note"><%= t("admin.tags.empty") %></p>
<% end %>

<p><%= link_to t("admin.tags.back_to_hub"), admin_tags_path %></p>
