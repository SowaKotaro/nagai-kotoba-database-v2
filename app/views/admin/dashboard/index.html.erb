<% content_for :title, t("admin.dashboard.title") %>

<div class="page-eyebrow"><span><%= t("admin.dashboard.eyebrow") %></span></div>
<h1 class="page-title"><%= t("admin.dashboard.title") %></h1>

<%# 収録状況。4 つの数を 1px の罫で割った 1 枚のパネルに並べ、最下段に注釈の進捗を置く %>
<p class="section-label"><%= t("admin.dashboard.stats.label") %></p>
<dl class="stats-grid">
  <div class="stats-grid__item">
    <dt><%= t("admin.dashboard.stats.words") %></dt>
    <dd><%= number_with_delimiter(@word_count) %><span class="stats-grid__unit"><%= t("admin.dashboard.stats.unit_word") %></span></dd>
  </div>
  <div class="stats-grid__item">
    <dt><%= t("admin.dashboard.stats.annotated") %></dt>
    <dd><%= number_with_delimiter(@annotated_count) %><span class="stats-grid__unit"><%= t("admin.dashboard.stats.unit_word") %></span></dd>
  </div>
  <div class="stats-grid__item <%= "stats-grid__item--pending" if @unannotated_count.positive? %>">
    <dt><%= t("admin.dashboard.stats.unannotated") %></dt>
    <dd><%= number_with_delimiter(@unannotated_count) %><span class="stats-grid__unit"><%= t("admin.dashboard.stats.unit_word") %></span></dd>
  </div>
  <div class="stats-grid__item">
    <dt><%= t("admin.dashboard.stats.senses") %></dt>
    <dd><%= number_with_delimiter(@sense_count) %><span class="stats-grid__unit"><%= t("admin.dashboard.stats.unit_sense") %></span></dd>
  </div>
  <%# 帯の長さも切り捨てた % で描く(1 語でも残っていれば満ちない)。値は隣の数字で読めるので帯は読み上げない %>
  <div class="stats-grid__item stats-grid__item--progress">
    <dt><%= t("admin.dashboard.stats.progress") %></dt>
    <dd>
      <span class="admin-meter" style="--meter: <%= @annotated_percent %>%" aria-hidden="true"></span>
      <span class="admin-meter__value"><%= number_to_percentage(@annotated_percent, precision: 0) %></span>
    </dd>
  </div>
</dl>

<p class="section-label"><%= t("admin.dashboard.actions_label") %></p>

<%# 各作業の入口。並びと見出しは共通ナビと同じ(admin_sections が正)。アノテーションのカードには、
    デッキ(まとめて注釈)への近道を添える %>
<ul class="admin-dash-grid">
  <% admin_sections.each do |section| %>
    <% pending = @pending_counts[section.key] %>
    <%= render "admin/shared/section_card",
               path: section.path, icon: section.icon, title: t("admin.nav.#{section.key}"),
               desc: t("admin.dashboard.sections.#{section.key}.desc"),
               meta: t("admin.dashboard.sections.#{section.key}.meta", count: pending),
               pending: pending.to_i.positive?,
               sublink: ([ t("admin.dashboard.deck"), admin_annotation_deck_path ] if section.key == :annotations) %>
  <% end %>
</ul>
