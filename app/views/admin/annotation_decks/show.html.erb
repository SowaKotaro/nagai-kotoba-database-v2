<% content_for :title, t("admin.annotation_decks.title") %>

<% if @words.empty? %>
  <%# キューが空。1語コンソールの完了画面と同じ導線に寄せる(下調べの補充 or 単語一覧) %>
  <div class="ann-done">
    <p class="ann-eyebrow"><span><%= t("admin.annotation_decks.title") %></span></p>
    <p class="ann-done__lead"><%= t("admin.annotation_decks.empty") %></p>
    <p><%= t("admin.annotation_decks.empty_lead") %></p>
    <p>
      <%= link_to t("admin.annotation_decks.to_console"), admin_annotations_path(nav_params), class: "btn" %>
      <%= link_to t("admin.annotations.to_export"), export_admin_annotation_proposals_path, class: "btn" %>
    </p>
  </div>
<% else %>
  <%= render "deck" %>
<% end %>
