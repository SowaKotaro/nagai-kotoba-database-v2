<%# デッキ全体で1つのフォーム。deck[<語id>][...] で語ごとに束ねて送り、
    サーバ側は語ごとに保存する(通った語だけ公開・落ちた語はカードに残る)。
    publish-guard は未完了のまま公開しようとしたときの確認(1語コンソールと共通)。 %>
<%= form_with url: admin_annotation_deck_path, method: :patch, class: "deck", id: "annotation-deck",
              data: { controller: "deck publish-guard",
                      action: "submit->publish-guard#guard " \
                              "sense-completeness:changed->deck#recount click->deck#recount",
                      publish_guard_message_value: t("admin.annotation_decks.publish_incomplete_confirm") } do %>
  <%# 絞り込み・並べ替え・枚数を保存後のリダイレクトでも保つ %>
  <% nav_params.merge(params[:size].present? ? { size: params[:size] } : {}).each do |key, value| %>
    <%= hidden_field_tag key, value %>
  <% end %>
  <%# 今どのカードを見ているか。マスタのその場作成(create_master)ではフォームごと送って
      デッキを組み直すので、戻ってきたときに同じカードへ戻れるようにする(deck が同期する) %>
  <%= hidden_field_tag :card, params[:card].presence || 0, data: { deck_target: "cardIndex" } %>

  <div class="ann-bar">
    <span class="ann-bar__counter">
      <%= t("admin.annotations.remaining") %>
      <span class="rest"><%= @remaining %></span> <%= t("admin.annotations.unit_word") %>
    </span>
    <span class="ann-bar__legend" aria-hidden="true">
      <span><key>&larr;</key><key>&rarr;</key><%= t("admin.annotation_decks.legend_move") %></span>
    </span>
    <span class="spacer"></span>
    <%= link_to t("admin.annotation_decks.to_console"), admin_annotations_path(nav_params),
                class: "deck-bar__link" %>
  </div>

  <p class="deck-lead"><%= t("admin.annotation_decks.lead", count: @words.size) %></p>

  <%# 提案キューのときだけ絞り込み・並べ替え(1語コンソールと同じ規則。デッキを組み直す) %>
  <% if proposed_param %>
    <%= render "admin/annotations/queue_filter", path_for: ->(query) { admin_annotation_deck_path(query) } %>
  <% end %>

  <%# カードの現在地。ドットはタップでそのカードへ飛ぶ(スワイプの補助) %>
  <nav class="deck-nav" aria-label="<%= t("admin.annotation_decks.nav_aria") %>">
    <button type="button" class="deck-nav__arrow" data-action="deck#prev"
            data-deck-target="prev" aria-label="<%= t("admin.annotation_decks.prev") %>">&larr;</button>
    <span class="deck-nav__position">
      <span data-deck-target="position">1</span> / <%= @words.size %>
    </span>
    <div class="deck-nav__dots">
      <% @words.each_with_index do |word, index| %>
        <button type="button" class="deck-dot" data-deck-target="dot" data-index="<%= index %>"
                data-action="deck#jump" title="<%= word.surface %>">
          <span><%= index + 1 %></span>
        </button>
      <% end %>
    </div>
    <button type="button" class="deck-nav__arrow" data-action="deck#next"
            data-deck-target="next" aria-label="<%= t("admin.annotation_decks.next") %>">&rarr;</button>
  </nav>

  <%# 用語解説はカードごとに繰り返すと重いので、デッキに1つだけ置く(Issue 39) %>
  <%= render "admin/annotations/glossary", extra_class: "deck-glossary" %>

  <%# 横スクロール + scroll-snap。スマホは横スワイプ、PC は矢印ボタン/キーで送る %>
  <div class="deck-track" data-deck-target="track">
    <% @words.each_with_index do |word, index| %>
      <%= render "card", word: word, index: index, total: @words.size, proposal: @proposals[word.id] %>
    <% end %>
  </div>

  <div class="ann-actionbar">
    <span class="deck-progress">
      <span data-deck-target="complete">0</span> / <%= @words.size %>
      <%= t("admin.annotation_decks.complete_unit") %>
    </span>
    <span class="spacer"></span>
    <%= submit_tag t("admin.annotation_decks.save_all", count: @words.size), class: "btn btn--primary" %>
  </div>
<% end %>
