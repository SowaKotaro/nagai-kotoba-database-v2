<%# 確認の一覧(仕分け・表記の確認で共用)。upload した順に並べ、同じ元の語から増えた語は系統として括る。
    系統の見出しの「すべて採用 / すべて除外」は、その系統の見えている行だけをそろえる(data-decision-scope)。
    元の語が一覧に無い系統(分割して不要にした語など)は、見出しに元の語のメモを出す。 %>
<div class="cand-list">
  <% review.groups.each do |group| %>
    <% if group.family? %>
      <section class="cand-family" data-decision-scope aria-label="<%= t("admin.word_candidates.family.label", root: group.root.surface) %>">
        <header class="cand-family__head">
          <p class="cand-family__title">
            <span class="cand-family__name"><%= t("admin.word_candidates.family.name", root: group.root.surface) %></span>
            <span class="cand-family__count"><%= t("admin.word_candidates.family.count", count: group.rows.size) %></span>
          </p>
          <span class="cand-family__actions">
            <% %w[keep reject].each do |decision| %>
              <button type="button" class="cand-family__action" data-action="decision-list#applyToScope" data-decision="<%= decision %>">
                <%= t("admin.word_candidates.family.apply_#{decision}") %>
              </button>
            <% end %>
          </span>
          <% if group.root.note.present? && !group.root_row?(group.rows.first) %>
            <p class="cand-family__note"><%= group.root.note %></p>
          <% end %>
        </header>
        <% group.rows.each do |row| %>
          <%= render "admin/candidates/row", row: row, choices: review.choices, form: form,
                root: group.root_row?(row), child: !group.root_row?(row) %>
        <% end %>
      </section>
    <% else %>
      <%= render "admin/candidates/row", row: group.rows.first, choices: review.choices, form: form, root: false, child: false %>
    <% end %>
  <% end %>
</div>
