<%= render "admin/candidates/header", current: "expand",
      title: t("admin.word_candidates.stages.expand.name"), lead: t(".lead") %>

<ol class="cand-steps-local">
  <li class="cand-step">
    <h2 class="cand-step__title"><%= t(".export_title") %></h2>
    <%= render "admin/candidates/export", export: @export, empty: t(".export_empty") %>
  </li>
  <li class="cand-step">
    <h2 class="cand-step__title"><%= t(".import_title") %></h2>
    <%= render "admin/candidates/import_form", url: import_admin_candidates_expansion_path,
          output: @export.target[:output], after: t(".import_after") %>
  </li>
</ol>
