<%= render "admin/candidates/header", current: "notation",
      title: t("admin.word_candidates.stages.notation.name"), lead: t(".lead") %>

<ol class="cand-steps-local">
  <li class="cand-step">
    <h2 class="cand-step__title"><%= t(".export_title") %></h2>
    <%= render "admin/candidates/export", export: @export, empty: t(".export_empty") %>
  </li>
  <li class="cand-step">
    <h2 class="cand-step__title"><%= t(".import_title") %></h2>
    <%= render "admin/candidates/import_form", url: import_admin_candidates_notation_path,
          output: @export.target[:output], after: t(".import_after") %>
  </li>
  <li class="cand-step" id="review">
    <h2 class="cand-step__title"><%= t(".review_title") %></h2>
    <% if @review.empty? %>
      <p class="cand-empty"><%= t(".review_empty") %></p>
    <% else %>
      <p class="cand-step__hint"><%= t(".review_hint") %></p>
      <%= form_with url: admin_candidates_notation_path, method: :patch, id: "cand-decisions", class: "cand-decisions" do %><% end %>
      <div class="cand-review" data-controller="decision-list" data-decision-list-form-value="cand-decisions"
           data-action="change->decision-list#changed click->decision-list#clicked keydown->decision-list#keydown keydown@window->decision-list#submitShortcut turbo:frame-render->decision-list#frameRendered">
        <%= render "admin/candidates/toolbar", reviews: [ @review ], choices: @review.choices %>
        <%= render "admin/candidates/review", review: @review, form: "cand-decisions" %>
        <%= render "admin/candidates/bar", choices: @review.choices, form: "cand-decisions", submit_label: t(".submit"),
              counts: @review.rows.map(&:default).tally %>
      </div>
    <% end %>
  </li>
</ol>
