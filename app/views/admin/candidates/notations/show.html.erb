<%= render "admin/candidates/header", current: @stage.key, title: candidate_stage_name(@stage), lead: t(".lead") %>

<ol class="cand-steps-local">
  <li class="panel cand-step">
    <div class="panel__head">
      <h2 class="panel__title"><%= t(".export_title") %></h2>
    </div>
    <div class="panel__body">
      <%= render "admin/candidates/export", export: @export, empty: t(".export_empty") %>
    </div>
  </li>
  <li class="panel cand-step">
    <div class="panel__head">
      <h2 class="panel__title"><%= t(".import_title") %></h2>
    </div>
    <div class="panel__body">
      <%= render "admin/candidates/import_form", url: import_admin_candidates_notation_path,
            output: @export.target[:output], after: t(".import_after") %>
    </div>
  </li>
  <%# 確かめる段は、一覧そのものが札(.cand-list)なので、外側は札にせず見出しだけを置く %>
  <li class="cand-step cand-step--review" id="review">
    <h2 class="cand-step__title"><%= t(".review_title") %></h2>
    <% if @review.empty? %>
      <p class="cand-empty"><%= t(".review_empty") %></p>
    <% else %>
      <p class="cand-step__hint"><%= t(".review_hint") %></p>
      <%= form_with url: admin_candidates_notation_path, method: :patch, id: "cand-decisions" do %><% end %>
      <%= tag.div class: "cand-review", data: candidate_review_data("cand-decisions") do %>
        <%= render "admin/candidates/toolbar", totals: @totals, choices: @review.choices %>
        <%= render "admin/candidates/review", review: @review, form: "cand-decisions" %>
        <%= render "admin/candidates/bar", choices: @review.choices, form: "cand-decisions", submit_label: t(".submit"),
              counts: @totals.default_counts %>
      <% end %>
    <% end %>
  </li>
</ol>
