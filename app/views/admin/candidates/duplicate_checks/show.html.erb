<% content_for :title, "duplicate" %>

<h1 class="page-title">duplicate</h1>
<p class="field-hint"><%= t(".lead") %></p>

<%= render "admin/word_candidates/flow", current: "duplicate" %>

<% if @candidates.any? %>
  <%= form_with url: admin_candidates_duplicate_check_path, method: :patch do %>
    <div class="table-scroll">
      <table class="data-table admin-candidates-table">
        <thead>
          <tr>
            <th class="admin-candidates-table__exclude"><%= t(".col_exclude") %></th>
            <th><%= t(".col_surface") %></th>
            <th><%= t(".col_matches") %></th>
          </tr>
        </thead>
        <tbody>
          <% @candidates.each_with_index do |candidate, i| %>
            <% matches = @matches.fetch(candidate.id, []) %>
            <tr class="<%= "is-matched" if matches.any? %>">
              <td class="admin-candidates-table__exclude">
                <%= hidden_field_tag "shown_ids[]", candidate.id, id: nil %>
                <%# 一致がある語は最初から「重複」にチェックしておく(外せば notation へ進む) %>
                <input type="checkbox" name="duplicated_ids[]" value="<%= candidate.id %>" <%= "checked" if matches.any? %>
                       aria-label="<%= t(".exclude_item", surface: candidate.surface) %>">
              </td>
              <td><%= render "admin/word_candidates/surface", candidate: candidate, previous: (@candidates[i - 1] if i.positive?) %></td>
              <td>
                <% if matches.empty? %>
                  <span class="candidate-surface__sub"><%= t(".no_match") %></span>
                <% else %>
                  <ul class="admin-candidates-table__matches">
                    <% matches.each do |match| %>
                      <li>
                        <% if match.candidate %>
                          <%= link_to match.surface, edit_admin_word_candidate_path(match.candidate) %>
                          <%= render "admin/word_candidates/badge", status: match.candidate.status %>
                        <% else %>
                          <%= link_to match.surface, word_path(match.word_id) %>
                          <span class="candidate-surface__sub"><%= t(".match_#{match.kind}") %></span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="actions candidate-finish">
      <%= submit_tag t(".finish"), class: "btn btn--primary" %>
    </div>
  <% end %>
<% else %>
  <p class="empty-note"><%= t(".empty") %></p>
<% end %>
