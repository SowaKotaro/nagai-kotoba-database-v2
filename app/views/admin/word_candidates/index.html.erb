<% content_for :title, t("admin.word_candidates.title") %>

<h1 class="page-title"><%= t("admin.word_candidates.title") %></h1>
<p class="field-hint"><%= t(".lead") %></p>

<%= render "flow", current: nil %>

<%# ステータスで絞り込む。バッジと同じ色で、件数を添える %>
<nav class="candidate-filter" aria-label="<%= t(".filter_label") %>">
  <%= link_to t(".filter_all", count: @status_counts.values.sum), admin_word_candidates_path,
        class: "candidate-filter__item", "aria-current": (@status.nil? ? "page" : nil) %>
  <% WordCandidate.statuses.each_key do |status| %>
    <%= link_to admin_word_candidates_path(status: status), class: "candidate-filter__item",
          "aria-current": (@status == status ? "page" : nil) do %>
      <%= render "badge", status: status %><span class="candidate-filter__count"><%= @status_counts.fetch(status, 0) %></span>
    <% end %>
  <% end %>
</nav>

<% if @status %>
  <p class="field-hint"><%= t("admin.word_candidates.hints.#{@status}") %></p>
<% end %>

<% if @candidates.any? %>
  <%# 選択した語に「行いたい処理」を当てる。expand・duplicate に回すとその段の画面へ移る。
      フォームはテーブルの外に置き、行のチェックボックスは form 属性で紐づける %>
  <div class="bulk-requests">
    <%= form_with url: bulk_admin_word_candidates_path, method: :post, id: "bulk-candidate-form" do %>
      <% { status: @status, page: (@page if @page > 1) }.compact.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <p class="bulk-requests__label"><%= t(".actions_label") %></p>
      <div class="actions actions--tight">
        <% WordCandidate::ACTIONS.each_key do |action| %>
          <%= button_tag t(".actions.#{action}"), type: "submit", name: "commit", value: action,
                class: "btn btn--sm #{'btn--primary' if action.in?(%w[to_expand to_duplicate])}" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <p class="admin-words-count"><%= t(".total", count: number_with_delimiter(@total_count)) %></p>

  <div class="table-scroll" data-controller="check-all">
    <table class="data-table admin-candidates-table">
      <thead>
        <tr>
          <th class="admin-words-table__check">
            <input type="checkbox" aria-label="<%= t(".select_all") %>"
                   data-check-all-target="toggle" data-action="check-all#toggle">
          </th>
          <th><%= t(".col_surface") %></th>
          <th><%= t(".col_status") %></th>
          <th><%= t(".col_note") %></th>
        </tr>
      </thead>
      <tbody>
        <% @candidates.each_with_index do |candidate, i| %>
          <tr>
            <td class="admin-words-table__check">
              <input type="checkbox" name="candidate_ids[]" value="<%= candidate.id %>"
                     form="bulk-candidate-form" aria-label="<%= t(".select_item", surface: candidate.surface) %>"
                     data-check-all-target="item" data-action="check-all#sync">
            </td>
            <td><%= render "surface", candidate: candidate, previous: (@candidates[i - 1] if i.positive?) %></td>
            <td class="admin-candidates-table__status"><%= render "badge", status: candidate.status %></td>
            <td class="admin-candidates-table__note">
              <% if candidate.entry_score %>
                <span class="admin-candidates-table__score"><%= t("admin.word_candidates.score", score: candidate.entry_score, confidence: candidate.confidence.presence || "—") %></span>
              <% end %>
              <%= candidate.note %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="pagination">
    <% base = request.query_parameters.except("page") %>
    <% if @page > 1 %>
      <%= link_to t("words.pagination.prev"), admin_word_candidates_path(base.merge(page: @page - 1)) %>
    <% end %>
    <span><%= t("words.pagination.status", page: @page, total: @total_pages) %></span>
    <% if @page < @total_pages %>
      <%= link_to t("words.pagination.next"), admin_word_candidates_path(base.merge(page: @page + 1)) %>
    <% end %>
  </nav>
<% else %>
  <p class="empty-note"><%= t(".empty") %></p>
<% end %>
