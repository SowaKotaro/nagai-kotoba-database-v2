<% content_for :title, t(".title") %>

<h1 class="page-title"><%= t(".title") %></h1>

<%= render "flow", current: "upload" %>

<% if flash.now[:alert] %>
  <p class="form-alert"><%= flash.now[:alert] %></p>
<% end %>

<%= form_with model: @intake, url: admin_word_candidates_path, scope: :word_candidate_intake do |form| %>
  <fieldset class="fieldset-card">
    <legend><%= t(".legend") %></legend>
    <p class="field-hint"><%= t(".hint", max: WordCandidateIntake::MAX_LINES) %></p>

    <div class="field">
      <%= form.label :text, t(".label") %>
      <%= form.text_area :text, rows: 12, class: "bulk-input", placeholder: t(".placeholder") %>
    </div>
  </fieldset>

  <div>
    <%= form.submit t(".submit"), class: "btn btn--primary" %>
  </div>
<% end %>

<p><%= link_to t(".back"), admin_word_candidates_path %></p>
