<%# コピー用の本文(調査スキルの入力や、一括登録に貼る完了リスト)。 %>
<div class="proposal-json" data-controller="clipboard"
     data-clipboard-text-value="<%= text %>"
     data-clipboard-copied-label-value="<%= t("admin.word_candidates.copy_box.copied") %>">
  <div class="proposal-json__bar">
    <span class="proposal-json__hint"><%= t("admin.word_candidates.copy_box.count", count: count) %></span>
    <button type="button" class="btn btn--sm" data-action="clipboard#copy">
      <span data-clipboard-target="label"><%= t("admin.word_candidates.copy_box.copy") %></span>
    </button>
  </div>
  <%= text_area_tag field, text, readonly: true, rows: [ [ count, 4 ].max, 14 ].min, class: "proposal-json__area" %>
</div>
