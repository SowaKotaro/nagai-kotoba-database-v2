<%# 表層形のセル。expand で増えた語は元の語の下に字下げし、最初の1語に「↳」を付ける。
    previous は同じ表で1つ上の行(元の語と続いているかの判定に使う)。 %>
<% child = candidate.seed_id.present? %>
<span class="candidate-surface <%= "candidate-surface--child" if child %>">
  <% if child %>
    <span class="candidate-surface__branch" aria-hidden="true"><%= candidate_branch_mark(candidate, previous) %></span>
  <% end %>
  <%= link_to candidate.surface, edit_admin_word_candidate_path(candidate) %>
  <% if candidate.original_surface != candidate.surface %>
    <span class="candidate-surface__sub"><%= t("admin.word_candidates.surface.original", surface: candidate.original_surface) %></span>
  <% end %>
</span>
