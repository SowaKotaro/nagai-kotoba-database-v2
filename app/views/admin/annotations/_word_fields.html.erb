<%# locals: (form:, word:, review_features_path: nil) -%>
<%# 語 1 つ分の注釈の入力(エラー・表層形の訂正・語義の並びと追加)。1語コンソールと単語の修正(Issue 108)が使う。
    form は語のフォームビルダ。review_features_path は語義の「特徴なしで確定」の送り先(_sense_fields)。
    デッキは語ごとに名前を束ねたカードで組むので、ここは使わない(admin/annotation_decks/_card) %>
<% if word.errors.any? %>
  <div class="error-explanation">
    <h2><%= t("admin.annotations.error_header") %></h2>
    <ul>
      <% word.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# 表層形の訂正。変更すると保存時に文字種も再生成される %>
<div class="ann-surface">
  <label class="ann-surface__label" for="word_surface"><%= t("admin.annotations.surface") %></label>
  <%= form.text_area :surface, rows: 1, class: "ann-surface__input", id: "word_surface" %>
  <span class="ann-surface__note"><%= t("admin.annotations.surface_note") %></span>
</div>

<div data-controller="sense-cloner">
  <div data-sense-cloner-target="container">
    <%# 語義の id は sense_fields が語義の枠の中に出す %>
    <%= form.fields_for :word_senses, include_id: false do |sense_form| %>
      <%= render "admin/annotations/sense_fields", form: sense_form, word: word, review_features_path: review_features_path %>
    <% end %>
  </div>

  <button type="button" class="ann-add-sense" data-action="sense-cloner#add">
    <%= t("admin.annotations.add_sense") %>
    <small><%= t("admin.annotations.add_sense_hint") %></small>
  </button>
</div>
