<%# locals: (path:, icon:, title:, desc:, meta:, pending: false, sublink: nil) -%>
<%# 作業の入口のカード(ダッシュボードと調査データ)。並べる側が ul.admin-dash-grid で包む。
    pending は未着手が残っている印(下端を --admin-warn にする)。sublink は下端に添える近道 [文言, パス]。
    カードの中に近道のリンクを置くため、カードそのものは <a> にせず、見出しのリンクをカード一面に広げて
    全体を押せるようにする(components.css。design.md §10.1.3) %>
<li class="admin-card">
  <%= link_to path, class: "admin-card__link" do %>
    <%= icon icon, "admin-card__icon" %>
    <span class="admin-card__title"><%= title %></span>
  <% end %>
  <%= icon "arrow_right", "admin-card__arrow" %>
  <p class="admin-card__desc"><%= desc %></p>
  <p class="admin-card__meta <%= "admin-card__meta--pending" if pending %>">
    <span><%= meta %></span>
    <% if sublink %>
      <%= link_to sublink.first, sublink.last, class: "admin-card__sublink" %>
    <% end %>
  </p>
</li>
