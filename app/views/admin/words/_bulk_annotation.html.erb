<%# locals: (word_origins:, parts_of_speech:, entity_types:, linguistic_features:, large_genres:) -%>
<%# まとめて付ける(Issue 37)。指定した項目だけを上書きし、空欄の項目は各語の現状を保つ。規則の正は BulkAnnotation。
    フォームは admin/words/_bulk_form %>
<details class="bulk-annotation">
  <summary class="bulk-annotation__summary"><%= icon "caret_down", "bulk-annotation__caret" %><%= t("admin.bulk_annotations.summary") %></summary>
  <p class="bulk-annotation__hint"><%= t("admin.bulk_annotations.hint") %></p>

  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.genre") %></div>
    <%= render "admin/words/bulk_genre_picker", name: "bulk_annotation[genre_id]", large_genres: large_genres %>
  </div>

  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.entity") %></div>
    <%= render "admin/words/bulk_radio_chips", name: "bulk_annotation[entity_type_id]", records: entity_types,
               blank_label: t("admin.bulk_annotations.keep") %>
  </div>

  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.pos") %></div>
    <%= render "admin/words/bulk_radio_chips", name: "bulk_annotation[part_of_speech_id]", records: parts_of_speech,
               blank_label: t("admin.bulk_annotations.keep") %>
  </div>

  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.origins") %></div>
    <div class="ann-chips">
      <% word_origins.each do |origin| %>
        <label class="ann-chip">
          <%= check_box_tag "bulk_annotation[word_origin_ids][]", origin.id, false, id: nil, class: "ann-chip__input" %>
          <%= origin.name %>
        </label>
      <% end %>
    </div>
  </div>

  <%# 言語学的特徴(Issue 108)。該当部分の文字列が表層形と読みの両方にある語だけに、表層形の最初の出現で付ける %>
  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.feature") %></div>
    <div>
      <%= render "admin/words/bulk_radio_chips", name: "bulk_annotation[linguistic_feature_id]", records: linguistic_features,
                 blank_label: t("admin.bulk_annotations.feature_keep") %>
      <div class="bulk-annotation__fields">
        <label class="bulk-annotation__field">
          <span class="bulk-annotation__field-label"><%= t("admin.bulk_annotations.feature_target") %></span>
          <%= text_field_tag "bulk_annotation[feature_target]", nil, id: nil, class: "bulk-annotation__input" %>
        </label>
        <label class="bulk-annotation__field">
          <span class="bulk-annotation__field-label"><%= t("admin.bulk_annotations.feature_target_reading") %></span>
          <%= text_field_tag "bulk_annotation[feature_target_reading]", nil, id: nil, class: "bulk-annotation__input",
                placeholder: t("admin.bulk_annotations.feature_target_reading_placeholder") %>
        </label>
      </div>
      <p class="bulk-annotation__hint"><%= t("admin.bulk_annotations.feature_hint") %></p>
    </div>
  </div>

  <div class="ann-row">
    <div class="ann-row__label"><%= t("admin.bulk_annotations.meaning") %></div>
    <div>
      <%= text_field_tag "bulk_annotation[meaning_template]", nil, id: nil,
            class: "bulk-annotation__meaning", placeholder: t("admin.bulk_annotations.meaning_placeholder") %>
    </div>
  </div>

  <div class="bulk-annotation__actionbar">
    <%# 注釈済みフラグは選択式・既定 OFF(docs/issues.md 確定事項 9) %>
    <label class="bulk-annotation__mark">
      <%= check_box_tag "bulk_annotation[mark_annotated]", "1", false, id: nil %>
      <%= t("admin.bulk_annotations.mark_annotated") %>
    </label>
    <%= submit_tag t("admin.bulk_annotations.submit"), name: nil, class: "btn btn--primary",
          data: { turbo_confirm: t("admin.bulk_annotations.confirm") } %>
  </div>
</details>
