<%# 一覧の1行(リストUI)。カードにせず 1px の細罫だけで仕切る。
    1件 = 言葉 / 読み / 文字数・ジャンル・エンティティ。
    左列に見出し語と読みを縦に積み、右列の上段に分類・種別、下段に文字数を置く
    (600px 以下は 1 列に縦積み。組み方の正は components.css の .entry-row)。
    品詞は一覧では出さない(語の見分けに効かないわりに幅を食うため。詳細と検索には残す)。
    行全体は詳細へのリンク(surface をストレッチ)。ジャンル・タグは各ファセットの
    単語一覧(絞り込み)への実リンクなので、行リンクの上に載せる。
    local: word / highlight(検索条件に当たった箇所。SearchHighlight。単語一覧からのみ渡る。関連語・しりとりの行は nil) %>
<% primary = word.primary_sense %>
<% highlight = local_assigns[:highlight] %>
<%# 1行 = 自己完結した見出し語エントリなので article(SEO/LLMO のセマンティクス) %>
<article class="entry-row">
  <div class="entry-row__head">
    <%# 語は inline の span に入れる。hover で引く下線(motion.css)を、行の中で折れた字に沿わせるため %>
    <%= link_to word_path(word), class: "entry-row__surface" do %><span class="entry-row__surface-text"><%= search_highlighted(word.surface, highlight&.surface(word)) %></span><% end %>
    <%# 同じ読みの語義が複数あっても、読みは 1 回だけ出す(語義ごとの読みは詳細で見る) %>
    <% readings = word.ordered_senses.map(&:reading).uniq %>
    <p class="entry-row__reading"><%= safe_join(readings.map { |reading| search_highlighted(reading, highlight&.reading(word, reading)) }, "、") %></p>
  </div>

  <div class="entry-row__data">
    <% if primary&.genre %>
      <%# ジャンルは大 › 中 › 小 のパンくず。どの階層からでも絞り込みへ飛べる %>
      <%= render "shared/genre_path", genre: primary.genre, modifier: "genre-path--sm" %>
    <% end %>
    <% if primary&.entity_type %>
      <%= link_to primary.entity_type.name,
            words_path(entity_type_id: primary.entity_type_id), class: "entry-row__tag" %>
    <% end %>
  </div>

  <%# 文字数は全行で桁が揃うので、右列の下段に右寄せで置いて縦に揃える %>
  <div class="entry-row__meta">
    <% if primary&.reading_length %>
      <span class="entry-row__len"><span class="entry-row__number"><%= primary.reading_length %></span><%= t("words.index.char_unit") %></span>
    <% end %>
    <%= icon "arrow_right", "entry-row__go" %>
  </div>

  <%# キーワード検索で別表記だけが当たった行は、なぜ出たのかを一言添える(Issue 72)。関連語・しりとりの行には出ない %>
  <% (highlight&.matched_variants(word) || []).each do |variant| %>
    <p class="entry-row__match"><%= t("words.index.variant_match", surface: variant.surface) %></p>
  <% end %>
</article>
