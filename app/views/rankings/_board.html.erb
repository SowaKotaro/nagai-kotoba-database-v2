<%# ランキング1枠。トップ・一覧と同じ墨の枠の札(.panel)に、見出し帯 → 順位表 → 足(もっと見る) の順で組む。
    行は「同じ値の組」1 つ(WordRanking#board): 順位(墨の枠の角)・代表の見出し語と読み・指標値(800 の数)。
    組にほかの語があれば、行の 2 段目に「ほかN語」として畳む。
    「もっと見る」は同じ並びキーの単語一覧へ渡し、そこから先は通常のページ送りで全件辿れる(docs/design.md §5.5.1)。
    locals: ranking(WordRanking), groups(#board の結果) %>
<section class="panel rank-panel" id="rank-<%= ranking.key.dasherize %>">
  <div class="panel__head">
    <h2 class="panel__title"><%= icon ranking.icon %><%= ranking.title %></h2>
  </div>

  <ol class="rank-list">
    <% groups.each do |group| %>
      <% representative = group[:representative] %>
      <li class="rank-row">
        <%# 同率の語は 1 つの組にまとまるので、順位は組ごとに 1 つだけ出る。1 位だけを塗るなどの差は付けない %>
        <span class="rank-row__no"><%= group[:rank] %></span>
        <span class="rank-row__main">
          <%# 語を inline の span に入れるのは、hover で引く下線(motion.css)を折れた字に沿わせるため %>
          <%= link_to word_path(representative[:id]), class: "rank-row__surface" do %><span class="rank-row__surface-text"><%= representative[:surface] %></span><% end %>
          <span class="rank-row__reading"><%= representative[:readings].join("、") %></span>
        </span>
        <%# 指標値はこの板の主題そのものの数なので、数だけを大きく太く立てる %>
        <span class="rank-row__value">
          <span class="rank-row__number"><%= ranking.decimal? ? number_with_precision(group[:value], precision: WordRanking::DECIMAL_PLACES) : number_with_delimiter(group[:value]) %></span><span class="rank-row__unit"><%= ranking.unit %></span>
        </span>

        <% if group[:others].any? %>
          <details class="rank-fold">
            <summary class="rank-fold__summary">
              <%= icon "caret_down", "rank-fold__caret" %><%= t(".others", count: group[:count] - 1) %>
            </summary>
            <ul class="rank-fold__list">
              <% group[:others].each do |word| %>
                <li><%= link_to word[:surface], word_path(word[:id]) %></li>
              <% end %>
            </ul>
            <%# 畳む語には上限がある(WordRanking::FOLD_LIMIT)。残りは同じ並びの一覧で続きを辿る(nofollow の理由は足と同じ) %>
            <% rest = group[:count] - 1 - group[:others].size %>
            <% if rest.positive? %>
              <%= link_to rank_fold_rest_path(ranking, group), class: "rank-fold__rest icon-label", rel: "nofollow" do %>
                <%= t(".rest", count: rest) %><%= icon "arrow_right" %>
              <% end %>
            <% end %>
          </details>
        <% end %>
      </li>
    <% end %>
  </ol>

  <%# 「もっと見る」は順位表を読み終えた位置(札の足)に置く。頭に置くと、見出しの長い板ではスマホで 2 行に折れる。
      遷移先は「同じ集合の順列違い」で必ず noindex になる。クロールさせる価値が無いので
      nofollow を付ける(全語は sitemap と素の一覧のページ送りから辿れる)。 %>
  <div class="rank-panel__foot">
    <%= link_to words_path(sort: ranking.key), class: "btn btn--sm rank-panel__more", rel: "nofollow" do %>
      <%= t("rankings.index.see_all") %><%= icon "arrow_right" %>
    <% end %>
  </div>
</section>
